{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "borderpulse-editorial-v1"
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "topicKey": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "operations-report",
        "source-explainer",
        "product-guide"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "synthesizedBy": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "enum": [
            "chatgpt-scheduled-task",
            "codex-local",
            "chatgpt-interactive"
          ]
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        }
      },
      "required": [
        "system",
        "runId",
        "model",
        "at"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 12,
          "maxLength": 80
        },
        "es": {
          "type": "string",
          "minLength": 12,
          "maxLength": 80
        }
      },
      "required": [
        "en",
        "es"
      ],
      "additionalProperties": false
    },
    "readerValue": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        }
      },
      "required": [
        "en",
        "es"
      ],
      "additionalProperties": false
    },
    "relatedCrossings": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]{6}$"
      }
    },
    "sources": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "secondary-discovery"
            ]
          },
          "publishedDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "publishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
          },
          "publicationDateEvidence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "role",
          "publishedDate",
          "publishedAt",
          "checkedAt",
          "publicationDateEvidence"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "minItems": 2,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "reported-fact",
              "background",
              "inference"
            ]
          },
          "text": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1600
              },
              "es": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1600
              }
            },
            "required": [
              "en",
              "es"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 240
                }
              },
              "required": [
                "sourceId",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "basisClaimIds": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "preserveTerms": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "required": [
          "id",
          "type",
          "text",
          "evidence",
          "basisClaimIds",
          "preserveTerms"
        ],
        "additionalProperties": false
      }
    },
    "articleClaimIds": {
      "minItems": 2,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "performedBy": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "enum": [
                "chatgpt-scheduled-task",
                "codex-local",
                "chatgpt-interactive"
              ]
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            }
          },
          "required": [
            "system",
            "runId",
            "model",
            "at"
          ],
          "additionalProperties": false
        },
        "method": {
          "type": "string",
          "const": "ai-source-and-language-review"
        },
        "claimIdsChecked": {
          "minItems": 2,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "semanticSupport": {
          "type": "string",
          "const": "pass"
        },
        "scopeAndDates": {
          "type": "string",
          "const": "pass"
        },
        "riskClassification": {
          "type": "string",
          "const": "routine-factual-reporting"
        },
        "translationConsistency": {
          "type": "string",
          "const": "pass"
        },
        "duplicateTopicCheck": {
          "type": "string",
          "const": "pass"
        },
        "headlineAndReaderValue": {
          "type": "string",
          "const": "pass"
        },
        "sourceInstructionsIgnored": {
          "type": "boolean",
          "const": true
        },
        "holds": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 40,
          "maxLength": 1200
        }
      },
      "required": [
        "performedBy",
        "method",
        "claimIdsChecked",
        "semanticSupport",
        "scopeAndDates",
        "riskClassification",
        "translationConsistency",
        "duplicateTopicCheck",
        "headlineAndReaderValue",
        "sourceInstructionsIgnored",
        "holds",
        "rationale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "topicKey",
    "category",
    "createdAt",
    "synthesizedBy",
    "title",
    "readerValue",
    "relatedCrossings",
    "sources",
    "claims",
    "articleClaimIds",
    "review"
  ],
  "additionalProperties": false
}
